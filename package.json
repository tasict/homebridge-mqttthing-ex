{
  "name": "homebridge-mqttthing-ex",
  "displayName": "MQTT Thing EX",
  "version": "1.2.2",
  "description": "Homebridge plugin supporting various HomeKit services over MQTT. A modern TypeScript rewrite of homebridge-mqttthing with a fully compatible configuration format.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": "^18.17.0 || ^20.9.0 || ^22.10.0 || ^24.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "build:ui": "tsc -p ui --noEmit && vite build --config ui/vite.config.ts",
    "generate:schema": "node scripts/generate-schema.mjs",
    "lint": "eslint src test ui/src scripts homebridge-ui/server.js homebridge-ui/server-lib.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run lint && npm run build && npm run build:ui && npm run generate:schema && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tasict/homebridge-mqttthing-ex.git"
  },
  "funding": {
    "type": "github",
    "url": "https://PayPal.Me/tasict"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "MQTT",
    "homekit",
    "Siri",
    "IoT",
    "ESPurna",
    "tasmota",
    "light",
    "light bulb",
    "switch",
    "outlet",
    "motion sensor",
    "occupancy sensor",
    "light sensor",
    "contact sensor",
    "doorbell",
    "smoke sensor",
    "security system",
    "humidity sensor",
    "temperature sensor",
    "garage door",
    "stateless programmable switch",
    "fan",
    "fanv2",
    "microphone",
    "speaker",
    "window covering",
    "blind",
    "leak sensor",
    "lock mechanism",
    "lock",
    "window",
    "door",
    "air quality sensor",
    "carbondioxide sensor",
    "air pressure sensor",
    "weather station",
    "valve",
    "sprinkler",
    "shower",
    "faucet",
    "thermostat",
    "heater cooler",
    "irrigation system",
    "air purifier",
    "dehumidifier"
  ],
  "author": "tasict",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/tasict/homebridge-mqttthing-ex/issues"
  },
  "homepage": "https://github.com/tasict/homebridge-mqttthing-ex#readme",
  "files": [
    "CHANGELOG.md",
    "dist",
    "codecs",
    "homebridge-ui",
    "config.schema.json",
    "docs",
    "vendor",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.1.0",
    "jsonpath-plus": "^10.4.0",
    "mqtt": "^5.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@homebridge/hap-nodejs": "^2.0.0",
    "@types/node": "^22.0.0",
    "aedes": "^0.51.0",
    "eslint": "^9.0.0",
    "homebridge": "^2.0.0",
    "lucide-preact": "^1.26.0",
    "preact": "^10.24.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
